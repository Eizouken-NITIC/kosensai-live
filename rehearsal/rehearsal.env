# リハーサル専用の使い捨ての値。本番は hosts/server/.env に別の値を設定する。
# 本番と同じく tools/kosensai_live/config.py が検証し、MediaMTX はこのファイルの MTX_PATHS_<Ch>_* から
# Ch のパスを作成する。

MTX_PATHS_CH1_SRTPUBLISHPASSPHRASE=rehearsal-ch1-passphrase
MTX_PATHS_CH2_SRTPUBLISHPASSPHRASE=rehearsal-ch2-passphrase
MTX_PATHS_CH3_SRTPUBLISHPASSPHRASE=rehearsal-ch3-passphrase

OBS_CH1_LISTEN_PASSPHRASE=rehearsal-ch1-listen
OBS_CH2_LISTEN_PASSPHRASE=rehearsal-ch2-listen
