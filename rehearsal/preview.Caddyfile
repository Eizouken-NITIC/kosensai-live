# プレビュー用の入口。リハーサル専用であり、本番には存在しない。
#
# 本番の Caddyfile はホスト名で site をマッチするので、素直にやると
# /etc/hosts への追記が要る。消し忘れると本番 DNS が引けなくなって事故るので、
# 代わりにこの入口を用意した。Host ヘッダを付け替えて本番 Caddy へ渡す。
#
# 入口は 2 つある。
#
#   :8080 平文。この PC から見るためのもの。証明書の警告が出ない。
#         ブラウザは http://localhost を安全なコンテキストとして扱うため、
#         MediaMTX が張る Secure 属性付きの Cookie もそのまま通る。
#
#   :8444 TLS。LAN の実機（スマホ等）から見るためのもの。
#         平文では localhost 以外で Secure な Cookie が保存されず再生が
#         始まらないため、実機で確かめるには TLS で開くほかにない。
#         ホスト名を持たない site なので、IP でも mDNS 名でも受けられる。
#         証明書は scripts/up.sh が LAN アドレスを SAN に入れて生成する。
#
# ⚠️ どちらもホスト名マッチと本番の TLS 設定自体は検証できない。
#    それらを確かめるには /etc/hosts に一時的に本番のホスト名を足して直接開く
#    （README の「本番と同じホスト名・TLS で開きたい場合」を参照）。
#
# {$DOMAIN} は compose.yml の environment から注入される。

{
	auto_https off
	admin off
}

(to_caddy) {
	reverse_proxy https://127.0.0.1:443 {
		header_up Host {$DOMAIN}

		transport http {
			tls
			tls_insecure_skip_verify
			tls_server_name {$DOMAIN}
		}
	}

	log {
		output stdout
		format console
	}
}

:8080 {
	import to_caddy
}

:8444 {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	import to_caddy
}
