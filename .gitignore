# 実値のパスフレーズ。絶対にコミットしない。
.env
hosts/server/.env
rehearsal/.env

# 証明書（本番は certbot、リハーサルは init サービスが生成する）
*.pem
*.key
hosts/server/certs/
rehearsal/generated/

# 配信サーバーのアクセスログ（来場者の IP を含む）
hosts/server/logs/

# 録画・作業ファイル
# 拡張子だけで無視すると、MPEG-TS のセグメントと TypeScript のソースが
# どちらも .ts のため区別できない。録画の置き場所を指定して限定する。
recordings/
*.mkv
*.mp4

# 一度きりの切り分けに使う実験コード
scratch/

# Python の実行で生成される
__pycache__/

# OS
.DS_Store
Thumbs.db

# SvelteKit
app/node_modules/
app/.svelte-kit/

# uv が作成する仮想環境
.venv/
