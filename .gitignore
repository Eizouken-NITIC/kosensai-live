# 実値のパスフレーズ。絶対にコミットしない。
.env
hosts/server/.env
rehearsal/.env

# 証明書（本番は certbot、リハーサルは up.sh が生成する）
*.pem
*.key
hosts/server/certs/
rehearsal/certs/

# 録画・作業ファイル
# 拡張子だけで無視すると、MPEG-TS のセグメントと TypeScript のソースが
# どちらも .ts のため区別できない。録画の置き場所を指定して限定する。
recordings/
rehearsal/out/
*.mkv
*.mp4

# 一度きりの切り分けに使う実験コード
scratch/

# OS
.DS_Store
Thumbs.db

# SvelteKit
app/node_modules/
app/.svelte-kit/
