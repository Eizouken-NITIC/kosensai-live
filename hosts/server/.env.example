# cp .env.example .env して実値を入れる。.env は git 管理外。
# 値の後ろにコメントを書かない（tools/config.py はコメントも値として読む）。
#
# 配信サーバーの compose に加えて、本部 PC の hosts/obs/srt-urls.py と tools/atem-stream/ も
# このファイルを読む。値の検証は tools/config.py が行う（compose の init サービスが実行する）。
#
# MediaMTX は MTX_<設定項目> 形式の環境変数で mediamtx.yml を上書きできる。
# パスごとのパスフレーズは MTX_PATHS_<パス名>_SRTPUBLISHPASSPHRASE。MediaMTX はこの変数から
# パスを作成するため、config.json の channels[].id ごとに 1 つずつ設定する。
#
# SRT のパスフレーズは 10〜79 文字。Ch ごとに別の値を使う。
#   生成例: openssl rand -base64 24
#
# MTX_PATHS_* は本部 OBS → 配信サーバーの送出にだけ使う。ATEM・スマートフォンには設定しない。
# ATEM・スマートフォン → 本部 OBS には OBS_<Ch>_LISTEN_PASSPHRASE を別に設定する。同じ値にすると、
# ATEM・スマートフォンを操作する人が本部 OBS を通さずに公開 Ch へ送出できてしまう。
#
# HQ_IP は本部 PC の IP。配信サーバーへの送出はこの IP とサーバー自身からだけ受け付ける。
# ATEM・スマートフォンの送信先もこの IP である（本部 PC と ATEM は同じスイッチに接続する）。
# SERVER_IP は本部 PC から見た配信サーバーの IP、ATEM_IP は ATEM の IP。

MTX_PATHS_CH1_SRTPUBLISHPASSPHRASE=CHANGEME_ch1_passphrase_10chars_min
MTX_PATHS_CH2_SRTPUBLISHPASSPHRASE=CHANGEME_ch2_passphrase_10chars_min
MTX_PATHS_CH3_SRTPUBLISHPASSPHRASE=CHANGEME_ch3_passphrase_10chars_min

OBS_CH1_LISTEN_PASSPHRASE=CHANGEME_ch1_listen_passphrase
OBS_CH2_LISTEN_PASSPHRASE=CHANGEME_ch2_listen_passphrase

HQ_IP=CHANGEME
SERVER_IP=CHANGEME
ATEM_IP=CHANGEME
