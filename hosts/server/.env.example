# cp .env.example .env して実値を入れる。.env は git 管理外。
#
# MediaMTX は MTX_<設定項目> 形式の環境変数で mediamtx.yml を上書きできる。
# パスごとのパスフレーズは MTX_PATHS_<パス名>_SRTPUBLISHPASSPHRASE。
#
# SRT のパスフレーズは 10〜79 文字。Ch ごとに別の値を使う。
#   生成例: openssl rand -base64 24
#
# MTX_PATHS_* は本部 OBS → 配信サーバーの送出にだけ使う。現場には渡さない。
# 現場 → 本部 OBS には OBS_<Ch>_LISTEN_PASSPHRASE を別に設定する。同じ値にすると、
# 現場の端末を持つ人が本部を通さずに公開 Ch へ送出できてしまう。
#
# HQ_IP は本部 PC の IP。配信サーバーへの送出はこの IP とサーバー自身からだけ受け付ける。

MTX_PATHS_CH1_SRTPUBLISHPASSPHRASE=CHANGEME_ch1_passphrase_10chars_min
MTX_PATHS_CH2_SRTPUBLISHPASSPHRASE=CHANGEME_ch2_passphrase_10chars_min
MTX_PATHS_CH3_SRTPUBLISHPASSPHRASE=CHANGEME_ch3_passphrase_10chars_min

OBS_CH1_LISTEN_PASSPHRASE=CHANGEME_ch1_listen_passphrase
OBS_CH2_LISTEN_PASSPHRASE=CHANGEME_ch2_listen_passphrase

HQ_IP=CHANGEME
